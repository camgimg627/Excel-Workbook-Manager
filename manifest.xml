<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>d019f377-d511-4a97-8573-94ceae555e8f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Contoso</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Workbook Manager"/>
  <Description DefaultValue="A template to get started."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.contoso.com/help"/>
  <AppDomains>
    <AppDomain>https://www.contoso.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_1">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="SharedRuntime" MinVersion="1.1"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="OpenFormulaEditorButton">
                  <Label resid="OpenFormulaEditorButton.Label"/>
                  <Supertip>
                    <Title resid="OpenFormulaEditorButton.Label"/>
                    <Description resid="OpenFormulaEditorButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openFormulaEditorCommand</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="OpenAndPullFormulaEditorButton">
                  <Label resid="OpenAndPullFormulaEditorButton.Label"/>
                  <Supertip>
                    <Title resid="OpenAndPullFormulaEditorButton.Label"/>
                    <Description resid="OpenAndPullFormulaEditorButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openAndPullFormulaEditorCommand</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="PullFormulaButton">
                  <Label resid="PullFormulaButton.Label"/>
                  <Supertip>
                    <Title resid="PullFormulaButton.Label"/>
                    <Description resid="PullFormulaButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>pullFormulaCommand</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="ApplyFormulaButton">
                  <Label resid="ApplyFormulaButton.Label"/>
                  <Supertip>
                    <Title resid="ApplyFormulaButton.Label"/>
                    <Description resid="ApplyFormulaButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyFormulaCommand</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BeautifyFormulaButton">
                  <Label resid="BeautifyFormulaButton.Label"/>
                  <Supertip>
                    <Title resid="BeautifyFormulaButton.Label"/>
                    <Description resid="BeautifyFormulaButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>beautifyFormulaCommand</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="InsertSelectionButton">
                  <Label resid="InsertSelectionButton.Label"/>
                  <Supertip>
                    <Title resid="InsertSelectionButton.Label"/>
                    <Description resid="InsertSelectionButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertSelectionFormulaCommand</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="KeyboardShortcuts">
            <Shortcut resid="OpenAndPullFormulaEditor.Shortcut">
              <Action xsi:type="ExecuteFunction">
                <FunctionName>openAndPullFormulaEditorCommand</FunctionName>
              </Action>
            </Shortcut>
            <Shortcut resid="PullFormula.Shortcut">
              <Action xsi:type="ExecuteFunction">
                <FunctionName>pullFormulaCommand</FunctionName>
              </Action>
            </Shortcut>
            <Shortcut resid="ApplyFormula.Shortcut">
              <Action xsi:type="ExecuteFunction">
                <FunctionName>applyFormulaCommand</FunctionName>
              </Action>
            </Shortcut>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with your sample add-in!"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Workbook Manager"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Task Pane"/>
        <bt:String id="OpenFormulaEditorButton.Label" DefaultValue="Open Formula Editor"/>
        <bt:String id="OpenAndPullFormulaEditorButton.Label" DefaultValue="Edit Active Formula"/>
        <bt:String id="OpenAndPullFormulaEditor.Shortcut" DefaultValue="Ctrl+Shift+Alt+E"/>
        <bt:String id="PullFormulaButton.Label" DefaultValue="Pull Formula"/>
        <bt:String id="ApplyFormulaButton.Label" DefaultValue="Apply Formula"/>
        <bt:String id="BeautifyFormulaButton.Label" DefaultValue="Beautify"/>
        <bt:String id="InsertSelectionButton.Label" DefaultValue="Insert Selection"/>
        <bt:String id="PullFormula.Shortcut" DefaultValue="Ctrl+Shift+Alt+P"/>
        <bt:String id="ApplyFormula.Shortcut" DefaultValue="Ctrl+Shift+Alt+A"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Your sample add-in loaded successfully. Go to the HOME tab and click the 'Show Task Pane' button to get started."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Click to Show a Taskpane"/>
        <bt:String id="OpenFormulaEditorButton.Tooltip" DefaultValue="Open Workbook Manager directly in Formula Editor."/>
        <bt:String id="OpenAndPullFormulaEditorButton.Tooltip" DefaultValue="Open Workbook Manager Formula Editor and pull the active cell formula immediately."/>
        <bt:String id="PullFormulaButton.Tooltip" DefaultValue="Pull the active cell formula into the Workbook Manager Formula Editor."/>
        <bt:String id="ApplyFormulaButton.Tooltip" DefaultValue="Apply the current Workbook Manager Formula Editor text back to the active cell."/>
        <bt:String id="BeautifyFormulaButton.Tooltip" DefaultValue="Beautify the formula currently in Workbook Manager Formula Editor."/>
        <bt:String id="InsertSelectionButton.Tooltip" DefaultValue="Insert the current Excel selection (or matching named range) into the Workbook Manager Formula Editor."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
